{
  "name": "forum-speakers",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/cms"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:cms": "npm run develop -w apps/cms",
    "build": "npm run build -w apps/cms && npm run build -w apps/web",
    "check": "npm run typecheck -w apps/web",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup.mjs"
  },
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2"
  }
}
